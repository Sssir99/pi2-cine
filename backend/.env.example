# Copia este archivo a ".env" (en esta misma carpeta) y completa los valores.
# El .env NO se sube a Git (está en .gitignore).

# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB Atlas (formato srv://).
# Reemplaza TU_USUARIO y TU_CONTRASEÑA por las credenciales del usuario de base de datos.
MONGO_URI=mongodb+srv://TU_USUARIO:TU_CONTRASEÑA@cluster-pi2-cine.uwwhgrd.mongodb.net/cine?retryWrites=true&w=majority
