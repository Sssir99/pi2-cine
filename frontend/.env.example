# URL base del backend Express (sin la barra final, sin /api).
# El cliente añade /api por su cuenta.
#
# En desarrollo: la API corre en otro puerto.
VITE_API_URL=http://localhost:3000
#
# En el despliegue de un solo servicio (Express sirve también el panel) déjalo VACÍO:
# el navegador pedirá /api al mismo origen del que salió la página.
# VITE_API_URL=
