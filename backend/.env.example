# Copia este archivo a ".env" (en esta misma carpeta) y completa los valores.
# El .env NO se sube a Git (está en .gitignore).

# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB Atlas (formato srv://).
# Reemplaza TU_USUARIO y TU_CONTRASEÑA por las credenciales del usuario de base de datos.
MONGO_URI=mongodb+srv://TU_USUARIO:TU_CONTRASEÑA@cluster-pi2-cine.uwwhgrd.mongodb.net/cine?retryWrites=true&w=majority

# Entorno. En Render se pone NODE_ENV=production.
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas. Vacío = cualquiera (desarrollo y mismo
# origen, que es el caso del despliegue de un solo servicio). Si el panel se publica aparte:
# ORIGENES_PERMITIDOS=https://mi-panel.netlify.app
ORIGENES_PERMITIDOS=

# Servidores DNS para que Atlas resuelva (config/dns.js). Opcional.
# DNS_SERVERS=1.1.1.1,8.8.8.8
